<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Filled (value) portion: flat cyan capsule -->
    <Style x:Key="Slider.FillButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Remaining portion: invisible but click/drag-able -->
    <Style x:Key="Slider.EmptyButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 15px white knob; ring color = owning Slider's Foreground. Hover/drag scales. -->
    <Style x:Key="Slider.SteelThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="knob"
                             Fill="{DynamicResource Brush.Card}"
                             Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}"
                             StrokeThickness="2"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270"
                                              Opacity="0.25" Color="#FF000000" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="knob" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="knob" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base horizontal slider; Foreground drives the thumb ring (defaults to cyan) -->
    <Style x:Key="Slider.Steel" TargetType="Slider">
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Slider.Track}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Style="{StaticResource Slider.FillButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Style="{StaticResource Slider.EmptyButton}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Slider.SteelThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Axis variants: same fill + track, only the thumb ring color changes -->
    <Style x:Key="Slider.Axis.X" TargetType="Slider" BasedOn="{StaticResource Slider.Steel}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Axis.X}" />
    </Style>
    <Style x:Key="Slider.Axis.Y" TargetType="Slider" BasedOn="{StaticResource Slider.Steel}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Axis.Y}" />
    </Style>
    <Style x:Key="Slider.Axis.Z" TargetType="Slider" BasedOn="{StaticResource Slider.Steel}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Axis.Z}" />
    </Style>

    <!-- Implicit alias: every bare <Slider> gets the steel look (remove for opt-in only) -->
    <Style TargetType="Slider" BasedOn="{StaticResource Slider.Steel}" />

</ResourceDictionary>