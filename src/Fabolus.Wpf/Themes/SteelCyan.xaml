<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <!-- ============================================================ -->
    <!--  PALETTE  (raw color tokens — single source of truth)        -->
    <!-- ============================================================ -->

    <!-- Steel neutrals -->
    <Color x:Key="Steel.AppBackground">#FFD9DFE3</Color>
    <Color x:Key="Steel.Surface">#FFE4EAEC</Color>
    <Color x:Key="Steel.Card">#FFFFFFFF</Color>
    <Color x:Key="Steel.Divider">#FFCCD4D8</Color>
    <Color x:Key="Steel.Border">#FFADB7BD</Color>
    <Color x:Key="Steel.BorderStrong">#FFB3BBC1</Color>
    <Color x:Key="Steel.Track">#FFD4DADE</Color>

    <!-- Steel scale (dark end) -->
    <Color x:Key="Steel.700">#FF2F3940</Color>
    <Color x:Key="Steel.900">#FF1B2227</Color>

    <!-- Brushed-metal chrome (title bar / status bar gradient stops) -->
    <Color x:Key="Steel.Brushed.Top">#FFE2E8EB</Color>
    <Color x:Key="Steel.Brushed.Bottom">#FFC7CFD4</Color>
    <Color x:Key="Steel.Brushed.BorderBottom">#FFC3CACF</Color>
    <Color x:Key="Steel.Status.Top">#FFEEF1F3</Color>
    <Color x:Key="Steel.Status.Bottom">#FFE1E6E9</Color>

    <!-- Graphite 3D viewport -->
    <Color x:Key="Steel.Viewport.Top">#FF3F4A52</Color>
    <Color x:Key="Steel.Viewport.Mid">#FF2A333A</Color>
    <Color x:Key="Steel.Viewport.Bottom">#FF1C2329</Color>

    <!-- Text -->
    <Color x:Key="Steel.Text.Primary">#FF1B2227</Color>
    <Color x:Key="Steel.Text.Secondary">#FF5E6B73</Color>
    <Color x:Key="Steel.Text.Muted">#FF8A969D</Color>
    <Color x:Key="Steel.Text.OnAccent">#FFFFFFFF</Color>

    <!-- Cyan accent -->
    <Color x:Key="Cyan.Accent">#FF0CA3B4</Color>
    <Color x:Key="Cyan.AccentHover">#FF2BC0D0</Color>
    <Color x:Key="Cyan.AccentPressed">#FF0B8593</Color>
    <Color x:Key="Cyan.AccentSoft">#FFE2F4F7</Color>

    <!-- Semantic -->
    <Color x:Key="Steel.Success">#FF2FA36B</Color>
    <Color x:Key="Steel.Warning">#FFE0A024</Color>
    <Color x:Key="Steel.Danger">#FFD64545</Color>

    <!-- Axis gizmo -->
    <Color x:Key="Axis.X">#FFE06B5E</Color>
    <Color x:Key="Axis.Y">#FF5FB97C</Color>
    <Color x:Key="Axis.Z">#FF5AA6E0</Color>

    <!-- ============================================================ -->
    <!--  SEMANTIC BRUSHES  (what controls actually bind to)          -->
    <!-- ============================================================ -->

    <!-- Backgrounds & surfaces -->
    <SolidColorBrush x:Key="Brush.App.Background" Color="{StaticResource Steel.AppBackground}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Steel.Surface}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Steel.Card}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Steel.Divider}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Steel.Border}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Steel.BorderStrong}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Slider.Track" Color="{StaticResource Steel.Track}" options:Freeze="True" />

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Steel.Text.Primary}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Steel.Text.Secondary}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Steel.Text.Muted}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Steel.Text.OnAccent}" options:Freeze="True" />

    <!-- Accent -->
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Cyan.Accent}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Cyan.AccentHover}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Cyan.AccentPressed}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{StaticResource Cyan.AccentSoft}" options:Freeze="True" />

    <!-- Semantic -->
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Steel.Success}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Steel.Warning}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Steel.Danger}" options:Freeze="True" />

    <!-- Axis gizmo -->
    <SolidColorBrush x:Key="Brush.Axis.X" Color="{StaticResource Axis.X}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Axis.Y" Color="{StaticResource Axis.Y}" options:Freeze="True" />
    <SolidColorBrush x:Key="Brush.Axis.Z" Color="{StaticResource Axis.Z}" options:Freeze="True" />

    <!-- Accent fill for the primary button (vertical cyan gradient) -->
    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="0,1" options:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource Cyan.Accent}" />
        <GradientStop Offset="1" Color="{StaticResource Cyan.AccentPressed}" />
    </LinearGradientBrush>

    <!-- Active-tab fill: soft cyan fading down to transparent (matches the mockup tab) -->
    <LinearGradientBrush x:Key="Brush.Tab.ActiveFill" StartPoint="0,0" EndPoint="0,1" options:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource Cyan.AccentSoft}" />
        <GradientStop Offset="1" Color="#00E2F4F7" />
    </LinearGradientBrush>

    <!-- Brushed-steel chrome (title bar) -->
    <LinearGradientBrush x:Key="Brush.Brushed.TitleBar" StartPoint="0,0" EndPoint="0,1" options:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource Steel.Brushed.Top}" />
        <GradientStop Offset="1" Color="{StaticResource Steel.Brushed.Bottom}" />
    </LinearGradientBrush>

    <!-- Brushed-steel chrome (status bar) -->
    <LinearGradientBrush x:Key="Brush.Brushed.StatusBar" StartPoint="0,0" EndPoint="0,1" options:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource Steel.Status.Top}" />
        <GradientStop Offset="1" Color="{StaticResource Steel.Status.Bottom}" />
    </LinearGradientBrush>

    <!-- Graphite viewport background (radial) -->
    <RadialGradientBrush x:Key="Brush.Viewport" GradientOrigin="0.5,0" Center="0.5,0" RadiusX="1.3" RadiusY="1.1" options:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource Steel.Viewport.Top}" />
        <GradientStop Offset="0.52" Color="{StaticResource Steel.Viewport.Mid}" />
        <GradientStop Offset="1" Color="{StaticResource Steel.Viewport.Bottom}" />
    </RadialGradientBrush>

    <!-- ============================================================ -->
    <!--  MAHAPPS.METRO THEME KEY OVERRIDES                           -->
    <!--  Re-point MahApps' accent/highlight keys at the cyan ramp so -->
    <!--  built-in controls (Slider, ToggleSwitch, MetroTabControl,   -->
    <!--  buttons, etc.) pick up the theme with no per-control work.  -->
    <!-- ============================================================ -->

    <!-- Accent color keys (MahApps reads these by name) -->
    <Color x:Key="MahApps.Colors.Accent">#FF0CA3B4</Color>
    <Color x:Key="MahApps.Colors.Accent2">#FF2BC0D0</Color>
    <Color x:Key="MahApps.Colors.Accent3">#FF0B8593</Color>
    <Color x:Key="MahApps.Colors.Accent4">#FFE2F4F7</Color>
    <Color x:Key="MahApps.Colors.Highlight">#FF0B8593</Color>
    <Color x:Key="MahApps.Colors.IdealForeground">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="MahApps.Brushes.Accent" Color="{StaticResource Cyan.Accent}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.Accent2" Color="{StaticResource Cyan.AccentHover}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.Accent3" Color="{StaticResource Cyan.AccentPressed}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.Accent4" Color="{StaticResource Cyan.AccentSoft}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.Highlight" Color="{StaticResource Cyan.AccentPressed}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.AccentBase" Color="{StaticResource Cyan.Accent}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.IdealForeground" Color="{StaticResource Steel.Text.OnAccent}" options:Freeze="True" />

    <!-- Window + surfaces -->
    <SolidColorBrush x:Key="MahApps.Brushes.ThemeBackground" Color="{StaticResource Steel.AppBackground}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.Control.Background" Color="{StaticResource Steel.Card}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.Window.Background" Color="{StaticResource Steel.AppBackground}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.Control.Border" Color="{StaticResource Steel.Border}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.Separator" Color="{StaticResource Steel.Divider}" options:Freeze="True" />

    <!-- Window title bar = brushed steel (active + non-active) -->
    <LinearGradientBrush x:Key="MahApps.Brushes.WindowTitle" StartPoint="0,0" EndPoint="0,1" options:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource Steel.Brushed.Top}" />
        <GradientStop Offset="1" Color="{StaticResource Steel.Brushed.Bottom}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MahApps.Brushes.WindowTitle.NonActive" StartPoint="0,0" EndPoint="0,1" options:Freeze="True">
        <GradientStop Offset="0" Color="{StaticResource Steel.Status.Top}" />
        <GradientStop Offset="1" Color="{StaticResource Steel.Status.Bottom}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MahApps.Brushes.WindowTitleColor" Color="{StaticResource Steel.Brushed.Top}" options:Freeze="True" />

    <!-- Text -->
    <SolidColorBrush x:Key="MahApps.Brushes.Text" Color="{StaticResource Steel.Text.Primary}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.ThemeForeground" Color="{StaticResource Steel.Text.Primary}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.Label.Text" Color="{StaticResource Steel.Text.Secondary}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.Gray" Color="{StaticResource Steel.Text.Muted}" options:Freeze="True" />

    <!-- ============================================================ -->
    <!--  TYPOGRAPHY                                                  -->
    <!--  Optional: ship IBM Plex with the app and reference it here. -->
    <!--  Place the .ttf files in Fabolus.Wpf/Resources/Fonts/ with   -->
    <!--  Build Action: Resource, then the pack URIs below resolve.   -->
    <!-- ============================================================ -->
    <FontFamily x:Key="Font.Sans">pack://application:,,,/Resources/Fonts/#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="Font.Mono">pack://application:,,,/Resources/Fonts/#IBM Plex Mono</FontFamily>

    <!-- If you don't bundle fonts, fall back to Segoe UI / Consolas: -->
    <!-- <FontFamily x:Key="Font.Sans">Segoe UI</FontFamily> -->
    <!-- <FontFamily x:Key="Font.Mono">Consolas</FontFamily> -->

    <system:Double x:Key="Font.Size.Title" xmlns:system="clr-namespace:System;assembly=mscorlib">22</system:Double>
    <system:Double x:Key="Font.Size.Heading" xmlns:system="clr-namespace:System;assembly=mscorlib">15</system:Double>
    <system:Double x:Key="Font.Size.Body" xmlns:system="clr-namespace:System;assembly=mscorlib">13</system:Double>
    <system:Double x:Key="Font.Size.Label" xmlns:system="clr-namespace:System;assembly=mscorlib">12</system:Double>
    <system:Double x:Key="Font.Size.Caption" xmlns:system="clr-namespace:System;assembly=mscorlib">11</system:Double>

    <!-- ============================================================ -->
    <!--  RADII / ELEVATION TOKENS                                    -->
    <!-- ============================================================ -->
    <CornerRadius x:Key="Radius.Input">6</CornerRadius>
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">11</CornerRadius>

    <DropShadowEffect x:Key="Shadow.Card" BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.14" Color="#FF141E28" />
    <DropShadowEffect x:Key="Shadow.Accent" BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.35" Color="{StaticResource Cyan.AccentPressed}" />

    <!-- ============================================================ -->
    <!--  STEP-NAV ICONS  (16x16 stroke geometries for the tab strip) -->
    <!--  Use with Stroke (not Fill); bind Stroke to the button's     -->
    <!--  Foreground so they recolor on hover/active. See usage.       -->
    <!-- ============================================================ -->
    <Geometry x:Key="Icon.Import">M8 2 L8 8.5 M5.4 6 L8 8.6 L10.6 6 M2.6 10.5 L2.6 12.4 a1 1 0 0 0 1 1 L12.4 13.4 a1 1 0 0 0 1 -1 L13.4 10.5</Geometry>
    <Geometry x:Key="Icon.Smooth">M2 10 C4 5.6 6 5.6 8 10 S12 14.4 14 10</Geometry>
    <Geometry x:Key="Icon.Rotate">M13.2 8 a5.2 5.2 0 1 1 -1.7 -3.9 M13.4 2.6 L13.4 5.2 L10.8 5.2</Geometry>
    <Geometry x:Key="Icon.Channels">M4.3 2.5 L4.3 13.5 M8 2.5 L8 13.5 M11.7 2.5 L11.7 13.5</Geometry>
    <Geometry x:Key="Icon.Mould">M8 2.2 L13.5 5 L13.5 11 L8 13.8 L2.5 11 L2.5 5 Z M2.5 5 L8 7.8 L13.5 5 M8 7.8 L8 13.8</Geometry>
    <Geometry x:Key="Icon.Split">M8 1.8 L8 14.2 M3 5 L3 11 M13 5 L13 11</Geometry>
    <Geometry x:Key="Icon.Export">M8 9.4 L8 2.6 M5.4 5.2 L8 2.6 L10.6 5.2 M2.6 10 L2.6 12.4 a1 1 0 0 0 1 1 L12.4 13.4 a1 1 0 0 0 1 -1 L13.4 10</Geometry>

    <!-- Viewport overlay icons (same 16x16 stroke style as the tab strip) -->
    <!-- One per WireframeMode. An obliquely projected box: silhouette only -> plus the -->
    <!-- visible edges -> plus the three edges hidden behind it. The projection is oblique -->
    <!-- rather than isometric so the far corner stays clear of the near one. -->
    <Geometry x:Key="Icon.Wireframe.None">M2.5 13.5 L2.5 5.5 L5.5 2.5 L13.5 2.5 L13.5 10.5 L10.5 13.5 Z</Geometry>
    <Geometry x:Key="Icon.Wireframe.Overlay">M2.5 13.5 L2.5 5.5 L5.5 2.5 L13.5 2.5 L13.5 10.5 L10.5 13.5 Z M2.5 5.5 L10.5 5.5 L10.5 13.5 M10.5 5.5 L13.5 2.5</Geometry>
    <Geometry x:Key="Icon.Wireframe.Only">M2.5 13.5 L2.5 5.5 L5.5 2.5 L13.5 2.5 L13.5 10.5 L10.5 13.5 Z M2.5 5.5 L10.5 5.5 L10.5 13.5 M10.5 5.5 L13.5 2.5 M5.5 2.5 L5.5 10.5 L13.5 10.5 M5.5 10.5 L2.5 13.5</Geometry>
    <Geometry x:Key="Icon.Screenshot">M1.6 6.2 a1.6 1.6 0 0 1 1.6 -1.6 L5.9 4.6 L7 2.9 L9 2.9 L10.1 4.6 L12.8 4.6 a1.6 1.6 0 0 1 1.6 1.6 L14.4 12 a1.6 1.6 0 0 1 -1.6 1.6 L3.2 13.6 a1.6 1.6 0 0 1 -1.6 -1.6 Z M10.5 9.2 a2.5 2.5 0 1 1 -5 0 a2.5 2.5 0 1 1 5 0</Geometry>
    <Geometry x:Key="Icon.Preferences">M2 4.4 L4.5 4.4 M7.5 4.4 L14 4.4 M7.5 4.4 a1.5 1.5 0 1 0 -3 0 a1.5 1.5 0 1 0 3 0 M2 8 L9 8 M12 8 L14 8 M12 8 a1.5 1.5 0 1 0 -3 0 a1.5 1.5 0 1 0 3 0 M2 11.6 L4 11.6 M7 11.6 L14 11.6 M7 11.6 a1.5 1.5 0 1 0 -3 0 a1.5 1.5 0 1 0 3 0</Geometry>

    <!-- ============================================================ -->
    <!--  COMPONENT STYLES                                            -->
    <!-- ============================================================ -->

    <!-- Primary action button (cyan gradient pill) -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.OnAccent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Accent.Gradient}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Slider.Track}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary button (outline on white) -->
    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Surface}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Divider}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  TAB STRIP  (view-mode nav: import / smooth / rotate / ...)  -->
    <!--  Borderless text tab. Active state = set Tag="active" on the -->
    <!--  button (do this with a per-button DataTrigger that compares -->
    <!--  CurrentViewTitle to that view's name — see usage below).     -->
    <!-- ============================================================ -->
    <Style x:Key="TabButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" Background="{TemplateBinding Background}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <!-- 2px bottom rail; cyan only when active -->
                        <Border x:Name="rail" Height="2" VerticalAlignment="Bottom" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                        </Trigger>
                        <!-- ACTIVE: driven by Tag="active" (set per-button, see usage) -->
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="rail" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Brush.Tab.ActiveFill}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Pressed}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Border.Strong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card / panel container -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Effect" Value="{StaticResource Shadow.Card}" />
    </Style>

    <!-- Tool rail / side panel -->
    <Style x:Key="ToolRail" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Divider}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <!-- Section label (mono, tracked, uppercase) -->
    <Style x:Key="Text.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- View title (e.g. "Smooth") -->
    <Style x:Key="Text.ViewTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Sans}" />
        <Setter Property="FontSize" Value="25" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <!-- Numeric / monospace value readout -->
    <Style x:Key="Text.Value" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Pressed}" />
    </Style>

    <!-- Status-bar text -->
    <Style x:Key="Text.Status" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    </Style>

    <!-- Selected-tag / pill (accent-soft chip) -->
    <Style x:Key="Tag.Accent" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Accent.Soft}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="7,4" />
    </Style>

    <!-- ============================================================ -->
    <!--  MESH LIST ITEM  (selectable row container for the mesh list) -->
    <!--  Retemplates ListBoxItem so the SELECTED row reads cyan       -->
    <!--  instead of system-blue. Apply via ListBox.ItemContainerStyle.-->
    <!--  The cyan accent bar on the left marks the selection.         -->
    <!-- ============================================================ -->
    <Style x:Key="MeshListItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" />
                        <!-- selection accent bar -->
                        <Border x:Name="bar" Width="3" HorizontalAlignment="Left" CornerRadius="3"
                                Background="Transparent" Margin="0,4" />
                        <ContentPresenter VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Surface}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Tab.ActiveFill}" />
                            <Setter TargetName="bar" Property="Background" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
