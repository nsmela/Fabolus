<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Fabolus.Wpf.Features.MeshManager">

    <Style x:Key="MeshRowIconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="5" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent.Soft}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="MeshItemTemplate" DataType="{x:Type local:MeshItem}">
        <Border x:Name="row" Padding="11,8"
                Background="Transparent"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource Brush.Divider}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="7" Height="7"
                         Fill="{DynamicResource Brush.Accent}"
                         Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Margin="0,0,10,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="{Binding Name}"
                           FontFamily="{StaticResource Font.Sans}" FontSize="13"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="2" Margin="4,0"
                        Style="{StaticResource MeshRowIconButton}"
                        Visibility="{Binding IsNotValid, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Command="{Binding DataContext.RepairMeshCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding Id}"
                        ToolTip="Repair Topology Issues">
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform" Width="14" Height="14"
                          Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.5 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
                </Button>

                <Button Grid.Column="3" Margin="4,0"
                        Style="{StaticResource MeshRowIconButton}"
                        Command="{Binding DataContext.ExportMeshCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding Id}"
                        ToolTip="Export Mesh">
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform" Width="14" Height="14"
                          Data="M19,9h-4V3H9v6H5l7,7L19,9z M5,18v2h14v-2H5z"/>
                </Button>

                <Button Grid.Column="4" Margin="4,0,0,0"
                        Style="{StaticResource MeshRowIconButton}"
                        Command="{Binding DataContext.DeleteMeshCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                        CommandParameter="{Binding Id}"
                        ToolTip="Remove from Workspace">
                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform" Width="12" Height="12"
                          Data="M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.9,2-2V7H6V19z"/>
                </Button>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>