<UserControl x:Class="Fabolus.Wpf.Features.MeshManager.MeshManagerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Fabolus.Wpf.Features.MeshManager"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="300"
      Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MeshItemTemplate.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,2,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="MESHES LOADED" VerticalAlignment="Center"
                       Style="{StaticResource Text.SectionLabel}"
                       Margin="2,8,0,8"/>

            <!-- Import Button -->
            <Button Grid.Column="1" Content="Import Mesh..."
                    Command="{Binding ImportFileCommand}"
                    Style="{StaticResource Button.Primary}"
                    Height="24" Width="120"
                    HorizontalAlignment="Stretch"/>
        </Grid>
        
        <!-- Divider -->
        <Border Grid.Row="1"
                Height="1"
                Background="{DynamicResource Brush.Divider}"
                Margin="0,10"/>

        <!-- Mesh List -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding MeshItems}"
                 SelectedItem="{Binding SelectedMesh, Mode=TwoWay}"
                 ItemTemplate="{StaticResource MeshItemTemplate}"
                 ItemContainerStyle="{StaticResource MeshListItem}"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"></ListBox>

        <!-- Empty State -->
        <StackPanel Grid.Row="2"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MeshItems.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- Mould icon as empty-state glyph -->
            <Viewbox Width="34" Height="34" Margin="0,0,0,12" HorizontalAlignment="Center">
                <Path Data="{StaticResource Icon.Mould}"
                      Stroke="{DynamicResource Brush.Border.Strong}" StrokeThickness="1.2" Fill="{x:Null}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Viewbox>
            <TextBlock Text="No meshes loaded"
                     FontFamily="{StaticResource Font.Sans}" FontSize="14" FontWeight="Medium"
                     Foreground="{DynamicResource Brush.Text.Secondary}"
                     HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Click 'Import Mesh...' to get started"
                     FontFamily="{StaticResource Font.Sans}" FontSize="11"
                     Foreground="{DynamicResource Brush.Text.Muted}"
                     HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>

</UserControl>
