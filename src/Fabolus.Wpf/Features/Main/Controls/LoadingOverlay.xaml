<UserControl x:Class="Fabolus.Wpf.Features.Main.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fabolus.Wpf.Features.Main.Controls"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             IsHitTestVisible="False"
             d:DesignWidth="640" d:DesignHeight="480">

    <!--  Indeterminate loading overlay for the 3D viewport.
          Drop into the same Grid cell as your HelixViewport / SharpDX host and bind:
              <controls:LoadingOverlay IsLoading="{Binding IsLoading}" />
          Visibility + spin/pulse animations are driven entirely by IsLoading.  -->

    <UserControl.Resources>
        <!--  Brushed-steel / cyan tokens  -->
        <Color x:Key="AccentColor">#FF0CA3B4</Color>
        <SolidColorBrush x:Key="AccentBrush"  Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="TrackBrush"   Color="#24FFFFFF" />
        <SolidColorBrush x:Key="LabelBrush"   Color="#FFD7DEE2" />
    </UserControl.Resources>

    <UserControl.Style>
        <Style TargetType="{x:Type local:LoadingOverlay}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="local:LoadingOverlay">
                        <!--  graphite scrim + centered spinner  -->
                        <Grid x:Name="RootGrid" Visibility="Collapsed">
                            <Grid.Background>
                                <RadialGradientBrush GradientOrigin="0.5,0.45" Center="0.5,0.45" RadiusX="0.7" RadiusY="0.7">
                                    <GradientStop Offset="0"   Color="#80141C22" />
                                    <GradientStop Offset="0.7" Color="#00141C22" />
                                    <GradientStop Offset="1"   Color="#00141C22" />
                                </RadialGradientBrush>
                            </Grid.Background>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!--  ring: static track + rotating accent arc  -->
                                <Grid Width="58" Height="58" HorizontalAlignment="Center">
                                    <Ellipse Stroke="{StaticResource TrackBrush}" StrokeThickness="3" />
                                    <Ellipse x:Name="AccentArc"
                                             Stroke="{StaticResource AccentBrush}"
                                             StrokeThickness="3"
                                             StrokeDashCap="Round"
                                             StrokeDashArray="29,29"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="{StaticResource AccentColor}"
                                                              BlurRadius="14" ShadowDepth="0" Opacity="0.45" />
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>

                                <TextBlock x:Name="StatusText"
                                           Text="PROCESSING MESH…"
                                           Margin="0,16,0,0"
                                           HorizontalAlignment="Center"
                                           FontFamily="IBM Plex Mono, Consolas"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource LabelBrush}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsLoading" Value="True">
                                <Setter TargetName="RootGrid" Property="Visibility" Value="Visible" />
                                <!--  start the ring + label animations on show  -->
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="LoadingStoryboard">
                                        <Storyboard>
                                            <!--  infinite ring rotation  -->
                                            <DoubleAnimation
                                                Storyboard.TargetName="AccentArc"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                From="0" To="360"
                                                Duration="0:0:0.82"
                                                RepeatBehavior="Forever" />
                                            <!--  soft pulse on the status label  -->
                                            <DoubleAnimation
                                                Storyboard.TargetName="StatusText"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0.55" To="1"
                                                Duration="0:0:0.8"
                                                AutoReverse="True"
                                                RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <!--  stop animating when hidden  -->
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="LoadingStoryboard" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Style>
</UserControl>
