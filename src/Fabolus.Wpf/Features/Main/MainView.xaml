<mah:MetroWindow x:Class="Fabolus.Wpf.Features.Main.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Fabolus.Wpf.Features.Main"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" 
        xmlns:common="clr-namespace:Fabolus.Wpf.Common.Mesh"
        xmlns:viewport="clr-namespace:Fabolus.Wpf.Features.Viewport"
        xmlns:mm="clr-namespace:Fabolus.Wpf.Features.MeshManager"
        xmlns:smooth="clr-namespace:Fabolus.Wpf.Features.Smoothing"
        mc:Ignorable="d"
        Title="FABOLUS" Height="720" Width="1340" MinHeight="520" MinWidth="600"
        ResizeMode="CanResizeWithGrip"
        TitleCharacterCasing="Upper"
        Background="{DynamicResource Brush.App.Background}"
        GlowBrush="{DynamicResource Brush.Accent}"
        NonActiveWindowTitleBrush="{DynamicResource Brush.Brushed.StatusBar}"
        TitleForeground="{DynamicResource Brush.Text.Primary}"
        WindowStartupLocation="CenterScreen">

    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type mm:MeshManagerViewModel}">
            <mm:MeshManagerView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type smooth:SmoothingViewModel}">
            <smooth:SmoothingView/>
        </DataTemplate>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#5E6B73"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}"
                         Foreground="{TemplateBinding Foreground}"
                         FontFamily="{TemplateBinding FontFamily}"
                         FontSize="{TemplateBinding FontSize}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- generic hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22000000"/>
                            </Trigger>
                            <!-- close button → red hover, white glyph -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="Tag" Value="close"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bg" Property="Background" Value="#D64545"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </mah:MetroWindow.Resources>

    <Grid>
            <!-- Grid Sizing Definitions-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="240" MaxWidth="440"/>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>

            <!-- App State -->
            <Border Grid.Row="0" Grid.Column="0"
            Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,1">
                <Label Content="{Binding CurrentViewTitle}"
           HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"
           Foreground="{DynamicResource Brush.Text.Primary}"
           FontFamily="\Fonts\#Poppins" FontSize="24" FontWeight="Bold"/>
            </Border>

            <!-- View Mode Bar -->
            <Border Grid.Row="0" Grid.Column="1"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="6,0">

                    <Button Command="{Binding SwitchToMeshManagerViewCommand}" >
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                                    <Path Data="{StaticResource Icon.Import}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Fill="{x:Null}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="meshes" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewTitle}" Value="meshes">
                                        <Setter Property="Tag" Value="active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding SwitchToSmoothingViewCommand}" IsEnabled="{Binding MeshLoaded}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                                    <Path Data="{StaticResource Icon.Smooth}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Fill="{x:Null}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="smooth" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewTitle}" Value="smooth">
                                        <Setter Property="Tag" Value="active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Command="{Binding SwitchToRotatationViewCommand}" IsEnabled="{Binding MeshLoaded}">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                                    <Path Data="{StaticResource Icon.Rotate}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" Fill="{x:Null}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="rotate" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource TabButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentViewTitle}" Value="rotate">
                                        <Setter Property="Tag" Value="active"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Border>

            <!-- Tools View  -->
            <Border Grid.Row="1" Grid.Column="0"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Direction="0"
                          Opacity="0.12" Color="#FF141E28"/>
                </Border.Effect>
                <ContentControl Content="{Binding CurrentView}" Margin="14,16"/>
            </Border>

            <!-- Information bar View -->
        <Border Grid.Row="2" Grid.ColumnSpan="2"
                Height="27" BorderThickness="0,1,0,0" BorderBrush="#D5DBDF">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#EEF1F3" Offset="0"/>
                    <GradientStop Color="#E1E6E9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding MeshName}" HorizontalAlignment="Left"
                       FontFamily="Consolas" FontSize="11" FontWeight="Medium"
                       Foreground="#0B8593"/>
                    <TextBlock Text="•" Margin="8,0" Foreground="#A8B1B6" VerticalAlignment="Center"/>
                    <TextBlock Text="Units: mm" FontFamily="Consolas" FontSize="11"
                        FontWeight="Medium" Foreground="#5E6B73"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--  MeshView -->
        <Grid Grid.Column="1" Grid.Row="1" Background="{DynamicResource Brush.Viewport}">
            <viewport:ViewportControl SceneManager="{Binding SceneManager}"  />
            
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="1"
              HorizontalAlignment="Left" VerticalAlignment="Stretch"
              Width="5" Background="Transparent"
              ResizeBehavior="PreviousAndCurrent" ResizeDirection="Columns"/>

        <!-- Tool buttons -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding ToggleWireframeCommand}" Width="33" Height="33" Margin="4"
                Style="{StaticResource Button.Secondary}" ToolTip="Toggle wireframes">
                    <Viewbox>
                        <Path Fill="{DynamicResource Brush.Text.Secondary}" 
                        Data="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m7.5-6.923c-.67.204-1.335.82-1.887 1.855q-.215.403-.395.872c.705.157 1.472.257 2.282.287zM4.249 3.539q.214-.577.481-1.078a7 7 0 0 1 .597-.933A7 7 0 0 0 3.051 3.05q.544.277 1.198.49zM3.509 7.5c.036-1.07.188-2.087.436-3.008a9 9 0 0 1-1.565-.667A6.96 6.96 0 0 0 1.018 7.5zm1.4-2.741a12.3 12.3 0 0 0-.4 2.741H7.5V5.091c-.91-.03-1.783-.145-2.591-.332M8.5 5.09V7.5h2.99a12.3 12.3 0 0 0-.399-2.741c-.808.187-1.681.301-2.591.332zM4.51 8.5c.035.987.176 1.914.399 2.741A13.6 13.6 0 0 1 7.5 10.91V8.5zm3.99 0v2.409c.91.03 1.783.145 2.591.332.223-.827.364-1.754.4-2.741zm-3.282 3.696q.18.469.395.872c.552 1.035 1.218 1.65 1.887 1.855V11.91c-.81.03-1.577.13-2.282.287zm.11 2.276a7 7 0 0 1-.598-.933 9 9 0 0 1-.481-1.079 8.4 8.4 0 0 0-1.198.49 7 7 0 0 0 2.276 1.522zm-1.383-2.964A13.4 13.4 0 0 1 3.508 8.5h-2.49a6.96 6.96 0 0 0 1.362 3.675c.47-.258.995-.482 1.565-.667m6.728 2.964a7 7 0 0 0 2.275-1.521 8.4 8.4 0 0 0-1.197-.49 9 9 0 0 1-.481 1.078 7 7 0 0 1-.597.933M8.5 11.909v3.014c.67-.204 1.335-.82 1.887-1.855q.216-.403.395-.872A12.6 12.6 0 0 0 8.5 11.91zm3.555-.401c.57.185 1.095.409 1.565.667A6.96 6.96 0 0 0 14.982 8.5h-2.49a13.4 13.4 0 0 1-.437 3.008M14.982 7.5a6.96 6.96 0 0 0-1.362-3.675c-.47.258-.995.482-1.565.667.248.92.4 1.938.437 3.008zM11.27 2.461q.266.502.482 1.078a8.4 8.4 0 0 0 1.196-.49 7 7 0 0 0-2.275-1.52c.218.283.418.597.597.932m-.488 1.343a8 8 0 0 0-.395-.872C9.835 1.897 9.17 1.282 8.5 1.077V4.09c.81-.03 1.577-.13 2.282-.287z"/>
                    </Viewbox>
                </Button>

                <Button Command="{Binding CaptureScreenshotCommand}" Width="33" Height="33" Margin="4"
                Style="{StaticResource Button.Secondary}" ToolTip="Toggle wireframes">
                    <Viewbox>
                        <Path Fill="{DynamicResource Brush.Text.Secondary}" 
                            Data="M2 4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-1.172a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 9.172 2H6.828a2 2 0 0 0-1.414.586l-.828.828A2 2 0 0 1 3.172 4zm.5 2a.5.5 0 1 1 0-1 .5.5 0 0 1 0 1m9 2.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0"/>

                    </Viewbox>

                </Button>

                <Button Command="{Binding OpenPreferencesCommand}" Width="33" Height="33" Margin="4"
                Style="{StaticResource Button.Secondary}" ToolTip="Toggle wireframes">
                    <Viewbox>
                        <Path Fill="{DynamicResource Brush.Text.Secondary}" 
                            Data="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z"/>
                    </Viewbox>

                </Button>

            </StackPanel>

            <!-- Info Pane-->
            <ContentControl Content="{Binding CurrentMeshInfo}" />
               
        </StackPanel>

        <local:InfoPanel Grid.Row="1" Grid.Column="1" DataContext="{Binding InfoViewModel}"/>
        
    </Grid>

</mah:MetroWindow>
