<mah:MetroWindow x:Class="Fabolus.Wpf.Features.AppPreferences.PreferencesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:conv="clr-namespace:Fabolus.Wpf.Common.Convert"
        xmlns:common="clr-namespace:Fabolus.Wpf.Common"
        xmlns:local="clr-namespace:Fabolus.Wpf.Features.AppPreferences"
        common:DataContextDisposal.AutoDispose="True"
        mc:Ignorable="d"
        Title="Preferences — Fabolus"
        TitleCharacterCasing="Normal"
        ShowIconOnTitleBar="True"
        SaveWindowPosition="False"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.App.Background}"
        Width="720" Height="500" MinWidth="620" MinHeight="440">

    <!-- brushed-steel logo chip in the title bar -->
    <mah:MetroWindow.IconTemplate>
        <DataTemplate>
            <Border Width="18" Height="18" Margin="9,0,2,0" CornerRadius="5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="{DynamicResource Cyan.Accent}" />
                        <GradientStop Offset="1" Color="{DynamicResource Cyan.AccentPressed}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </DataTemplate>
    </mah:MetroWindow.IconTemplate>

    <Window.Resources>
        <conv:ResourceKeyConverter x:Key="ResourceKey" />
        <local:PreferenceRowTemplateSelector x:Key="RowTemplates" />

        <!-- text helpers -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        </Style>
        <Style x:Key="PanelSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="Margin" Value="0,2,0,16" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource RowLabel}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- divider-topped row -->
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,12" />
        </Style>

        <Style x:Key="SegmentGroup" TargetType="Border">
            <Setter Property="Background" Value="#FFEDF1F3" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- folder browse button ("...") -->
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <!-- outlined footer action (Import / Export) -->
        <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="98" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- link-style text button (footer "Restore defaults") -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- sidebar category row -->
        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" />
                            <Border x:Name="bar" Width="3" HorizontalAlignment="Left" CornerRadius="3"
                                    Background="Transparent" Margin="0,7" />
                            <ContentPresenter VerticalAlignment="Center" Margin="12,9" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.App.Background}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent.Soft}" />
                                <Setter TargetName="bar" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="SidebarItemTemplate" DataType="{x:Type local:IPreferenceSection}">
            <StackPanel Orientation="Horizontal">
                <Path x:Name="ic" Width="16" Height="16" Stretch="Uniform"
                      Data="{Binding IconKey, Converter={StaticResource ResourceKey}}" Stroke="{DynamicResource Brush.Text.Secondary}"
                      StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <TextBlock x:Name="tx" Text="{Binding Name}" Margin="11,0,0,0" VerticalAlignment="Center"
                           FontFamily="{DynamicResource Font.Sans}" FontSize="13"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="ic" Property="Stroke" Value="{DynamicResource Brush.Accent.Pressed}" />
                    <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource Brush.Accent.Pressed}" />
                    <Setter TargetName="tx" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============================================================
             ROW TEMPLATES
             One per row type. A section describes its rows; these draw them, so a new
             preference is a line in that feature's section class and nothing here.
             ============================================================ -->

        <!-- shared: label, optional unit suffix, optional caption -->
        <DataTemplate x:Key="RowLabelBlock">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{Binding Label}" />
                    <TextBlock Text="{Binding Unit}" Margin="5,0,0,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{Binding UnitBrushKey, Converter={StaticResource ResourceKey}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Unit}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock Text="{Binding Caption}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowCaption}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Caption}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- group heading -->
        <DataTemplate DataType="{x:Type local:HeaderRow}">
            <StackPanel IsEnabled="{Binding IsEnabled}">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,18,0,0" Text="{Binding Label}" />
                <TextBlock Style="{StaticResource RowCaption}" Margin="0,0,0,4" Text="{Binding Caption}" />
            </StackPanel>
        </DataTemplate>

        <!-- closing note -->
        <DataTemplate DataType="{x:Type local:NoteRow}">
            <TextBlock Style="{StaticResource RowCaption}" Margin="0,12,0,0"
                       IsEnabled="{Binding IsEnabled}" Text="{Binding Caption}" />
        </DataTemplate>

        <!-- on / off -->
        <DataTemplate DataType="{x:Type local:ToggleRow}">
            <Border Style="{StaticResource Row}" IsEnabled="{Binding IsEnabled}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" Margin="0,0,16,0" Content="{Binding}"
                                      ContentTemplate="{StaticResource RowLabelBlock}" />
                    <mah:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{Binding Value}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- number with a spinner -->
        <DataTemplate DataType="{x:Type local:NumberRow}">
            <Border Style="{StaticResource Row}" IsEnabled="{Binding IsEnabled}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" Margin="0,0,16,0" Content="{Binding}"
                                      ContentTemplate="{StaticResource RowLabelBlock}" />
                    <mah:NumericUpDown Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Width="128"
                                       Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                       Interval="{Binding Interval}" StringFormat="{Binding StringFormat}"
                                       Value="{Binding Value}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- segmented choice -->
        <DataTemplate DataType="{x:Type local:SegmentedRow}">
            <Border Style="{StaticResource Row}" IsEnabled="{Binding IsEnabled}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" Margin="0,0,16,0" Content="{Binding}"
                                      ContentTemplate="{StaticResource RowLabelBlock}" />
                    <Border Grid.Column="1" Style="{StaticResource SegmentGroup}" HorizontalAlignment="Right">
                        <ListBox ItemsSource="{Binding Choices}"
                                 SelectedValuePath="Value"
                                 SelectedValue="{Binding Value}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" CornerRadius="5" Background="Transparent" Padding="13,5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#22FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}"
                                               FontFamily="{DynamicResource Font.Sans}" FontSize="11.5" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- drop-down choice -->
        <DataTemplate DataType="{x:Type local:DropdownRow}">
            <Border Style="{StaticResource Row}" IsEnabled="{Binding IsEnabled}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" Margin="0,0,16,0" Content="{Binding}"
                                      ContentTemplate="{StaticResource RowLabelBlock}" />
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" Width="{Binding PickerWidth}"
                              ItemsSource="{Binding Choices}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Value}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- drop-down paired with its own switch -->
        <DataTemplate DataType="{x:Type local:AnchoredToggleRow}">
            <Border Style="{StaticResource Row}" IsEnabled="{Binding IsEnabled}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" Margin="0,0,16,0" Content="{Binding}"
                                      ContentTemplate="{StaticResource RowLabelBlock}" />
                    <ComboBox Grid.Column="1" Width="104" VerticalAlignment="Center" Margin="0,0,12,0"
                              IsEnabled="{Binding Value}"
                              ItemsSource="{Binding Choices}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding Anchor}" />
                    <mah:ToggleSwitch Grid.Column="2" VerticalAlignment="Center" IsOn="{Binding Value}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- folder with a browse button -->
        <DataTemplate DataType="{x:Type local:FolderRow}">
            <StackPanel Margin="0,0,0,14" IsEnabled="{Binding IsEnabled}">
                <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Label}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="32" CornerRadius="6" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <TextBlock Text="{Binding Value}" VerticalAlignment="Center" Margin="10,0"
                                   TextTrimming="CharacterEllipsis" FontFamily="{DynamicResource Font.Mono}"
                                   FontSize="11.5" Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource BrowseButton}" Margin="8,0,0,0"
                            Content="..." Command="{Binding Browse}" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- bespoke: the overhang pair, whose thumbs cannot cross -->
        <DataTemplate x:Key="PreferenceRow.OverhangRange">
            <Border Style="{StaticResource Row}" IsEnabled="{Binding IsEnabled}">
                <StackPanel DataContext="{Binding Context}">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource RowLabel}" Text="Overhang thresholds" HorizontalAlignment="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding OverhangWarningAngle, StringFormat={}{0:0}&#176;}"
                                       FontFamily="{DynamicResource Font.Mono}" FontSize="12.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.Warning}" />
                            <TextBlock Text="&#8211;" FontFamily="{DynamicResource Font.Mono}" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="5,0"
                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                            <TextBlock Text="{Binding OverhangCriticalAngle, StringFormat={}{0:0}&#176;}"
                                       FontFamily="{DynamicResource Font.Mono}" FontSize="12.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.Danger}" />
                        </StackPanel>
                    </Grid>

                    <mah:RangeSlider Minimum="40" Maximum="90" MinRange="1" MinRangeWidth="5"
                                     LowerValue="{Binding OverhangWarningAngle, Mode=TwoWay}"
                                     UpperValue="{Binding OverhangCriticalAngle, Mode=TwoWay}" />

                    <Grid Margin="0,7,0,0">
                        <TextBlock Text="40&#176;" HorizontalAlignment="Left"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                        <TextBlock Text="90&#176;" HorizontalAlignment="Right"
                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                    </Grid>

                    <TextBlock Style="{StaticResource RowCaption}" Margin="0,10,0,0"
                               Text="Surfaces past the first threshold shade yellow, past the second red." />
                </StackPanel>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- ===== FOOTER ===== -->
        <Border DockPanel.Dock="Bottom" Height="52" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Brush.Brushed.StatusBar}">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource FooterButton}"
                            ToolTip="Replace every preference with the contents of a profile file"
                            Command="{Binding ImportPreferencesCommand}">
                        <StackPanel Orientation="Horizontal" Margin="11,0">
                            <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                <Path Data="{DynamicResource Icon.Import}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Fill="{x:Null}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                            <TextBlock Text="Import…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource FooterButton}" Margin="8,0,0,0"
                            ToolTip="Save every preference to a profile file"
                            Command="{Binding ExportPreferencesCommand}">
                        <StackPanel Orientation="Horizontal" Margin="11,0">
                            <Viewbox Width="13" Height="13" Margin="0,0,7,0">
                                <Path Data="{DynamicResource Icon.Export}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Fill="{x:Null}"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            </Viewbox>
                            <TextBlock Text="Export…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- stays a quiet link: destructive, and not something to invite a stray click -->
                    <Button Style="{StaticResource LinkButton}" Margin="18,0,0,0"
                            Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource Button.Secondary}"
                            Content="Cancel" MinWidth="84" Click="OnCancelClick" />
                    <Button x:Name="SaveButton" Style="{StaticResource Button.Primary}" Margin="9,0,0,0"
                            Height="34" MinWidth="118" Content="Save changes" Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== BODY ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- search -->
                    <Border DockPanel.Dock="Top" Margin="12,12,12,6" Height="32" CornerRadius="7"
                            Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="14" Height="14" Margin="10,0,0,0" Stretch="Uniform"
                                  Data="M10.4 10.4 14 14 M11.4 7 a4.4 4.4 0 1 1 -8.8 0 a4.4 4.4 0 0 1 8.8 0"
                                  Stroke="{DynamicResource Brush.Text.Muted}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                     Margin="8,0,8,0" FontFamily="{DynamicResource Font.Sans}" FontSize="12.5"
                                     Foreground="{DynamicResource Brush.Text.Primary}"
                                     mah:TextBoxHelper.Watermark="Search settings"
                                     mah:TextBoxHelper.UseFloatingWatermark="False"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="SETTINGS" Margin="20,6,0,8"
                               FontFamily="{DynamicResource Font.Mono}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Border.Strong}" />

                    <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" Margin="10,0,10,10"
                             ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection}"
                             ItemContainerStyle="{StaticResource SidebarItem}"
                             ItemTemplate="{StaticResource SidebarItemTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <!-- CONTENT PANE -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Card}">
                <StackPanel Margin="24,20">
                    <TextBlock Style="{StaticResource PanelTitle}" Text="{Binding SelectedSection.Name}" />
                    <TextBlock Style="{StaticResource PanelSubtitle}" Text="{Binding SelectedSection.Description}" />

                    <ItemsControl ItemsSource="{Binding Rows}"
                                  ItemTemplateSelector="{StaticResource RowTemplates}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</mah:MetroWindow>

