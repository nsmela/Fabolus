<mah:MetroWindow x:Class="Fabolus.Wpf.Features.About.AboutView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:local="clr-namespace:Fabolus.Wpf.Features.About"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:AboutViewModel}"
        Title="About Fabolus"
        TitleCharacterCasing="Normal"
        SaveWindowPosition="False"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.App.Background}"
        Width="520" SizeToContent="Height">

    <Window.Resources>
        <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="98" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,20">

        <TextBlock Text="Fabolus" FontSize="24" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.Text.Primary}" />
        <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Margin="0,2,0,0"
                   FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                   Foreground="{DynamicResource Brush.Text.Secondary}" />
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="Prepares radiotherapy bolus meshes for 3D printing and designs the sacrificial moulds they are cast in." />

        <!-- The medical disclaimer: the one part of this window that has to be read. -->
        <Border Margin="0,16,0,0" Padding="14,12" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource Brush.Warning}" Background="{DynamicResource Brush.Surface}">
            <StackPanel>
                <TextBlock Text="Medical disclaimer" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Warning}" />
                <TextBlock Text="{Binding Disclaimer}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,16,0,8" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="Released under the MIT License. Fabolus runs entirely on this computer: it makes no network connections of its own and collects no telemetry." />

        <WrapPanel>
            <Button Style="{StaticResource LinkButton}" Content="Licence" Command="{Binding OpenLicenceCommand}" />
            <Button Style="{StaticResource LinkButton}" Content="Third-party notices" Command="{Binding OpenThirdPartyNoticesCommand}" />
            <Button Style="{StaticResource LinkButton}" Content="Documentation" Command="{Binding OpenDocumentationCommand}" />
            <Button Style="{StaticResource LinkButton}" Content="Source code" Command="{Binding OpenRepositoryCommand}" />
        </WrapPanel>

        <Button Style="{StaticResource Button.Primary}" Content="Close" IsDefault="True" IsCancel="True"
                HorizontalAlignment="Right" Height="34" MinWidth="98" Margin="0,8,0,0" Click="OnCloseClick" />
    </StackPanel>

</mah:MetroWindow>
