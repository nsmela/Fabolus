<UserControl x:Class="Fabolus.Wpf.Features.PartingSplit.PartingSplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Fabolus.Wpf.Features.PartingSplit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <Grid>
        <!-- Non-mould meshes: parting split doesn't apply -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMould}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel Margin="16">
                <TextBlock Text="Parting Split" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Generate a mould first - parting split works on the mould shell, not the base mesh." TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <!-- Mould meshes -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMould}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel Margin="16">
                <TextBlock Text="Parting Split" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                
                <!-- Dynamic Header -->
                <TextBlock FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentState}" Value="DirectionSelection">
                                    <Setter Property="Text" Value="Step 1: Parting Direction" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentState}" Value="PartingLinePreview">
                                    <Setter Property="Text" Value="Step 2: Parting Line Preview" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentState}" Value="ToolWithBaseMesh">
                                    <Setter Property="Text" Value="Step 3: Tool and Original Mesh" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentState}" Value="ToolWithMould">
                                    <Setter Property="Text" Value="Step 4: Tool and Mould Mesh" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentState}" Value="FinalPartedMould">
                                    <Setter Property="Text" Value="Step 5: Final Split Regions" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Dynamic Description -->
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentState}" Value="DirectionSelection">
                                    <Setter Property="Text" Value="Drag the gizmo or use sliders to set the pull direction. Red faces will go to the positive half, green faces to the negative half." />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentState}" Value="PartingLinePreview">
                                    <Setter Property="Text" Value="Review the generated parting line loops (yellow)." />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentState}" Value="ToolWithBaseMesh">
                                    <Setter Property="Text" Value="Review the generated parting solid (green) against the original mesh." />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentState}" Value="ToolWithMould">
                                    <Setter Property="Text" Value="Review the generated parting solid (green) against the mould block." />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentState}" Value="FinalPartedMould">
                                    <Setter Property="Text" Value="Review the final positive (blue) and negative (orange) mould halves." />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Step 1 Only: Sliders -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentState}" Value="DirectionSelection">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Direction X" Margin="0,0,0,4"/>
                        <Slider Minimum="-1" Maximum="1" Value="{Binding DirectionX}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Direction Y" Margin="0,0,0,4"/>
                        <Slider Minimum="-1" Maximum="1" Value="{Binding DirectionY}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Direction Z" Margin="0,0,0,4"/>
                        <Slider Minimum="-1" Maximum="1" Value="{Binding DirectionZ}" />
                    </StackPanel>
                    <Button Content="Reset Direction" Command="{Binding ResetDirectionCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,16"/>
                </StackPanel>

                <!-- Step 2 Only: Hole Warning -->
                <Border Background="#332ECC71" BorderBrush="#2ECC71" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentState}" Value="PartingLinePreview">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding InternalHoleCount, StringFormat='{}{0} internal hole(s) detected - an additional parting mesh will be generated for each.'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding InternalHoleCount}" Value="0">
                                        <Setter Property="Text" Value="Parting line generated - no internal holes detected." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Navigation Controls -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Back Button -->
                    <Button Grid.Column="0" Content="Back" Command="{Binding PreviousStateCommand}" HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentState}" Value="DirectionSelection">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Next Button -->
                    <Button Grid.Column="2" Content="Next" Command="{Binding NextStateCommand}" HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentState}" Value="FinalPartedMould">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <!-- Apply Split Button -->
                    <Button Grid.Column="2" Content="Apply Split" Command="{Binding ApplySplitCommand}" HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentState}" Value="FinalPartedMould">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
