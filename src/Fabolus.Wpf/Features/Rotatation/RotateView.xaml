<UserControl x:Class="Fabolus.Wpf.Features.Rotatation.RotateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Fabolus.Wpf.Features.Rotatation"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:RotateViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="486" d:DesignWidth="222">

    <UserControl.Resources>

        <!-- Small colored chip carrying the axis letter -->
        <Style x:Key="AxisChip" TargetType="Border">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="AxisChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Round knob for the RangeSlider thumbs, matching Slider.SteelThumb -->
        <Style x:Key="RangeKnob" TargetType="{x:Type mah:MetroThumb}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type mah:MetroThumb}">
                        <Ellipse x:Name="knob"
                         Fill="{DynamicResource Brush.Card}"
                         Stroke="{DynamicResource Brush.Accent}"
                         StrokeThickness="2"
                         RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270"
                                          Opacity="0.25" Color="#FF000000" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="knob" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="knob" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Tool rail shell -->
    <Border Style="{StaticResource ToolRail}">
        <Grid Margin="16,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- section label -->
                <RowDefinition Height="Auto" />
                <!-- X -->
                <RowDefinition Height="Auto" />
                <!-- Y -->
                <RowDefinition Height="Auto" />
                <!-- Z -->
                <RowDefinition Height="*" />
                <!-- spacer -->
                <RowDefinition Height="Auto" />
                <!-- reset -->
            </Grid.RowDefinitions>

            <!-- Section label -->
            <TextBlock Grid.Row="0" Text="ROTATION"
                       Style="{StaticResource Text.SectionLabel}"
                       Margin="0,0,0,16" />

            <!-- X axis -->
            <StackPanel Grid.Row="1" Margin="0,0,0,18">
                <Grid Margin="0,0,0,7">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Style="{StaticResource AxisChip}" Background="{DynamicResource Brush.Axis.X}">
                            <TextBlock Text="X" Style="{StaticResource AxisChipText}" />
                        </Border>
                        <TextBlock Text="Rotate X" VerticalAlignment="Center" Margin="9,0,0,0"
                                   FontFamily="{StaticResource Font.Sans}" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding XAxisAngle, StringFormat={}{0:0}°}"
                               Style="{StaticResource Text.Value}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="-180" Maximum="180"
                        Style="{StaticResource Slider.Axis.X}"
                        Value="{Binding XAxisAngle, Mode=TwoWay}"
                        SmallChange="1" LargeChange="15"
                        local:SliderExtension.DragCompletedCommand="{Binding SaveAxisRotationCommand}"
                        VerticalAlignment="Center">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseEnter">
                            <i:InvokeCommandAction Command="{Binding ShowAxisXRotationCommand}" />
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseLeave">
                            <i:InvokeCommandAction Command="{Binding HideAxisRotationCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Slider>
            </StackPanel>

            <!-- Y axis -->
            <StackPanel Grid.Row="2" Margin="0,0,0,18">
                <Grid Margin="0,0,0,7">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Style="{StaticResource AxisChip}" Background="{DynamicResource Brush.Axis.Y}">
                            <TextBlock Text="Y" Style="{StaticResource AxisChipText}" />
                        </Border>
                        <TextBlock Text="Rotate Y" VerticalAlignment="Center" Margin="9,0,0,0"
                                   FontFamily="{StaticResource Font.Sans}" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding YAxisAngle, StringFormat={}{0:0}°}"
                               Style="{StaticResource Text.Value}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="-180" Maximum="180"
                        Style="{StaticResource Slider.Axis.Y}"
                        Value="{Binding YAxisAngle, Mode=TwoWay}"
                        SmallChange="1" LargeChange="15"
                        local:SliderExtension.DragCompletedCommand="{Binding SaveAxisRotationCommand}"
                        VerticalAlignment="Center" >
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseEnter">
                            <i:InvokeCommandAction Command="{Binding ShowAxisYRotationCommand}" />
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseLeave">
                            <i:InvokeCommandAction Command="{Binding HideAxisRotationCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Slider>
            </StackPanel>

            <!-- Z axis -->
            <StackPanel Grid.Row="3" Margin="0,0,0,18">
                <Grid Margin="0,0,0,7">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Style="{StaticResource AxisChip}" Background="{DynamicResource Brush.Axis.Z}">
                            <TextBlock Text="Z" Style="{StaticResource AxisChipText}" />
                        </Border>
                        <TextBlock Text="Rotate Z" VerticalAlignment="Center" Margin="9,0,0,0"
                                   FontFamily="{StaticResource Font.Sans}" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ZAxisAngle, StringFormat={}{0:0}°}"
                               Style="{StaticResource Text.Value}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Slider Minimum="-180" Maximum="180"
                        Style="{StaticResource Slider.Axis.Z}"
                        Value="{Binding ZAxisAngle, Mode=TwoWay}"
                        SmallChange="1" LargeChange="15"
                        local:SliderExtension.DragCompletedCommand="{Binding SaveAxisRotationCommand}"
                        VerticalAlignment="Center" >
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseEnter">
                            <i:InvokeCommandAction Command="{Binding ShowAxisZRotationCommand}" />
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseLeave">
                            <i:InvokeCommandAction Command="{Binding HideAxisRotationCommand}" />
                        </i:EventTrigger>
                        <i:EventTrigger EventName="Thumb.DragCompleted">
                            <i:InvokeCommandAction Command="{Binding SaveAxisRotationCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </Slider>
            </StackPanel>

            <StackPanel Grid.Row="4">
                <Grid Margin="0,0,0,7">
                    <TextBlock Text="Overhang thresholds" Style="{DynamicResource FieldLabel}" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding WarningAngle, StringFormat={}{0:0}°}"
                       Style="{StaticResource Text.Value}" Foreground="{DynamicResource Brush.Warning}" />
                        <TextBlock Text="–" Style="{StaticResource Text.Value}" Margin="5,0" />
                        <TextBlock Text="{Binding CriticalAngle, StringFormat={}{0:0}°}"
                       Style="{StaticResource Text.Value}" Foreground="{DynamicResource Brush.Danger}" />
                    </StackPanel>
                </Grid>
                <mah:RangeSlider Minimum="{Binding OverhangAngleMinimum}" Maximum="{Binding OverhangAngleMaximum}" MinHeight="18"
                 LowerValue="{Binding WarningAngle, Mode=TwoWay}"
                 UpperValue="{Binding CriticalAngle, Mode=TwoWay}"
                 MinRange="{Binding OverhangMinimumGap}" MinRangeWidth="5"
                 Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 VerticalContentAlignment="Stretch">
                    <mah:RangeSlider.Template>
                        <ControlTemplate TargetType="{x:Type mah:RangeSlider}">
                            <Grid x:Name="PART_Container" Background="{TemplateBinding Background}" VerticalAlignment="Center">
                                <StackPanel x:Name="PART_RangeSliderContainer" Orientation="Horizontal" Background="Transparent">
                                    <!-- unfilled track before the lower thumb -->
                                    <RepeatButton x:Name="PART_LeftEdge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Slider.Track}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>

                                    <!-- lower (warning) knob -->
                                    <mah:MetroThumb x:Name="PART_LeftThumb" Style="{StaticResource RangeKnob}" />

                                    <!-- selected range: filled bar, drag to move the whole range -->
                                    <mah:MetroThumb x:Name="PART_MiddleThumb" MinWidth="{TemplateBinding MinRangeWidth}" Cursor="Hand">
                                        <mah:MetroThumb.Template>
                                            <ControlTemplate TargetType="{x:Type mah:MetroThumb}">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Accent}" />
                                            </ControlTemplate>
                                        </mah:MetroThumb.Template>
                                    </mah:MetroThumb>

                                    <!-- upper (critical) knob -->
                                    <mah:MetroThumb x:Name="PART_RightThumb" Style="{StaticResource RangeKnob}" />

                                    <!-- unfilled track after the upper thumb -->
                                    <RepeatButton x:Name="PART_RightEdge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Slider.Track}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </StackPanel>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </mah:RangeSlider.Template>
                </mah:RangeSlider>
            </StackPanel>
            
            <!-- Spacer pushes Reset to the bottom of the rail -->

            <!-- Reset -->
            <Button Grid.Row="5"
                    Command="{Binding ClearRotationsCommand}"
                    Content="Reset"
                    Style="{StaticResource Button.Secondary}"
                    HorizontalAlignment="Stretch" />

        </Grid>
    </Border>

</UserControl>
